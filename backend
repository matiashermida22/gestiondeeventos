# ViewSets DRF: CRUD automático por cada modelo
from rest_framework import viewsets
from .models import Venue, Category, Event, Attendee
from .serializers import VenueSerializer, CategorySerializer, EventSerializer, AttendeeSerializer

class VenueViewSet(viewsets.ModelViewSet):
    queryset = Venue.objects.all().order_by("name")
    serializer_class = VenueSerializer

class CategoryViewSet(viewsets.ModelViewSet):
    queryset = Category.objects.all().order_by("name")
    serializer_class = CategorySerializer

class EventViewSet(viewsets.ModelViewSet):
    queryset = Event.objects.select_related("venue","category").all().order_by("-start_time")
    serializer_class = EventSerializer

class AttendeeViewSet(viewsets.ModelViewSet):
    queryset = Attendee.objects.select_related("event").all().order_by("full_name")
    serializer_class = AttendeeSerializer
PY

