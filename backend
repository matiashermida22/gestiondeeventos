import React, { useEffect, useState } from 'react'
import api from '../api'
export default function Events() {
  const [items, setItems] = useState([])
  const [venues, setVenues] = useState([])
  const [categories, setCategories] = useState([])
  const [form, setForm] = useState({title:'',description:'',start_time:'',end_time:'',venue:'',category:''})
  const [editingId, setEditingId] = useState(null)
  const load = async () => {
    const [ev, ve, ca] = await Promise.all([api.get('/events/'), api.get('/venues/'), api.get('/categories/')])
    setItems(ev.data); setVenues(ve.data); setCategories(ca.data)
  }
  useEffect(()=>{ load() }, [])
  const submit = async e => {
    e.preventDefault()
    const payload = {...form, venue: Number(form.venue)||null, category: Number(form.category)||null}
    if (editingId) await api.put(`/events/${editingId}/`, payload)
    else await api.post('/events/', payload)
    setForm({title:'',description:'',start_time:'',end_time:'',venue:'',category:''}); setEditingId(null); load()
  }
  const edit = it => {
    setEditingId(it.id)
    setForm({title:it.title,description:it.description||'',start_time:it.start_time.slice(0,16),end_time:it.end_time.slice(0,16),venue:it.venue||'',category:it.category||''})
  }
  const del = async id => { if(!confirm('¿Eliminar evento?')) return; await api.delete(`/events/${id}/`); load() }
  return (
    <div style={{padding:16}}>
      <h2>Eventos</h2>
      <form onSubmit={submit} style={{display:'grid', gap:8, maxWidth:600}}>
        <input placeholder="Título" value={form.title} onChange={e=>setForm({...form, title:e.target.value})} required />
        <textarea placeholder="Descripción" value={form.description} onChange={e=>setForm({...form, description:e.target.value})} />
        <label>Inicio <input type="datetime-local" value={form.start_time} onChange={e=>setForm({...form, start_time:e.target.value})} required /></label>
        <label>Fin <input type="datetime-local" value={form.end_time} onChange={e=>setForm({...form, end_time:e.target.value})} required /></label>
        <label>Sede
          <select value={form.venue} onChange={e=>setForm({...form, venue:e.target.value})} required>
            <option value="">--</option>{venues.map(v=><option key={v.id} value={v.id}>{v.name}</option>)}
          </select>
        </label>
        <label>Categoría
          <select value={form.category} onChange={e=>setForm({...form, category:e.target.value})}>
            <option value="">--</option>{categories.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}
          </select>
        </label>
        <button type="submit">{editingId ? 'Guardar' : 'Crear'}</button>
        {editingId && <button type="button" onClick={()=>{setEditingId(null); setForm({title:'',description:'',start_time:'',end_time:'',venue:'',category:''})}}>Cancelar</button>}
      </form>
      <table border="1" cellPadding="6" style={{marginTop:16, borderCollapse:'collapse'}}>
        <thead><tr><th>ID</th><th>Título</th><th>Inicio</th><th>Fin</th><th>Sede</th><th>Categoría</th><th>Acciones</th></tr></thead>
        <tbody>
          {items.map(it=>(
            <tr key={it.id}>
              <td>{it.id}</td><td>{it.title}</td>
              <td>{new Date(it.start_time).toLocaleString()}</td>
              <td>{new Date(it.end_time).toLocaleString()}</td>
              <td>{it.venue_name}</td><td>{it.category_name || '-'}</td>
              <td><button onClick={()=>edit(it)}>Editar</button><button onClick={()=>del(it.id)}>Eliminar</button></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
